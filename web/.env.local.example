# Copie para `web/.env.local` (gitignored). Não committe senhas reais.

# URI do Neo4j local (docker-compose)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# Senha do Neo4j — no compose de lab o default é documentado; troque em produção
# NEO4J_PASSWORD=

# URL da API Atlas usada pelo frontend
# NEXT_PUBLIC_ATLAS_API_URL=http://localhost:8001

# Se Neo4j estiver offline, a API pode cair no grafo em memória a partir da KB local
# (KB fica em data/ e não vai para o git).

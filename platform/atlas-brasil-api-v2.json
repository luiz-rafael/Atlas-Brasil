{
  "produto": "ATLAS BRASIL",
  "versao": "2.2.0",
  "base_url": "/api/v1",
  "fonte": "data/atlas-brasil-kb-v2.json + Neo4j",
  "grafo_motor": "neo4j+memoria",
  "ux_principio": "Simplicidade na entrada, profundidade na exploração",
  "niveis_usuario": ["entenda", "explore", "investigue"],
  "rotas_web": {
    "/": "Home — hero + atalhos Pesquisar / Ver a história / Explorar relações",
    "/explorar": "Entrada por pessoa, partido, empresa, caso",
    "/timeline": "Master timeline 1985-2026 com filtros por governo/eixo",
    "/grafo": "Grafo macro + ego com profundidade 1-3 (Cytoscape)",
    "/grafo/hubs": "Ranking de centralidade (degree/betweenness/closeness/eigenvector)",
    "/grafo/comunidades": "Comunidades + pontes entre grupos",
    "/grafo/conexao": "Caminho mais curto entre A e B",
    "/grafo/encontros": "Pontos de encontro entre redes",
    "/casos": "Lista de dossiês",
    "/casos/:id": "Página de caso (estrutura §19 atualizações)",
    "/pessoas": "Banco de pessoas",
    "/pessoas/:id": "Perfil (estrutura §20 + estrutura.md §7)",
    "/empresas": "Banco de empresas",
    "/empresas/:id": "Perfil empresa",
    "/instituicoes": "STF, PF, PGR, Congresso...",
    "/partidos/:id": "Perfil partido",
    "/dinheiro": "Mapas financeiros por camadas",
    "/fontes": "Sistema de fontes níveis 1-4 com URLs",
    "/fontes/:id": "Página de documento",
    "/metodologia": "Princípios, camadas epistêmicas, regra de ouro"
  },
  "rotas_app": ["inicio", "buscar", "timeline", "grafo", "salvos"],
  "endpoints": [
    {"method": "GET", "path": "/health"},
    {"method": "GET", "path": "/meta"},
    {"method": "GET", "path": "/governos"},
    {"method": "GET", "path": "/pessoas", "query": ["q", "partido", "no_poder", "tag", "governo"]},
    {"method": "GET", "path": "/pessoas/{id}"},
    {"method": "GET", "path": "/pessoas/{id}/timeline"},
    {"method": "GET", "path": "/pessoas/{id}/relacoes"},
    {"method": "GET", "path": "/empresas", "query": ["q", "setor"]},
    {"method": "GET", "path": "/empresas/{id}"},
    {"method": "GET", "path": "/partidos/{id}"},
    {"method": "GET", "path": "/casos", "query": ["eixo", "governo"]},
    {"method": "GET", "path": "/casos/{id}"},
    {"method": "GET", "path": "/registros", "query": ["status", "camada", "caso_id", "no_poder"]},
    {"method": "GET", "path": "/mecanismos", "query": ["classificacao", "caso_id"]},
    {"method": "GET", "path": "/grafo", "query": ["centro_id", "profundidade", "de", "ate", "tipos"]},
    {"method": "GET", "path": "/grafo/caminho", "query": ["a", "b", "max"]},
    {"method": "GET", "path": "/grafo/encontros", "query": ["a", "b", "depth"]},
    {"method": "GET", "path": "/grafo/por-que", "query": ["a", "b"], "descricao": "Por que A e B estão conectados?"},
    {"method": "GET", "path": "/grafo/hubs", "query": ["metric", "tipo", "de", "ate", "por_periodo", "graus"]},
    {"method": "GET", "path": "/grafo/comunidades", "query": ["mode", "de", "ate", "graus"]},
    {"method": "GET", "path": "/timeline", "query": ["caso_id", "eixo", "governo_id", "de", "ate"]},
    {"method": "GET", "path": "/timeline/como-chegamos", "query": ["evento_id"]},
    {"method": "GET", "path": "/financeiro", "query": ["caso_id"]},
    {"method": "GET", "path": "/centrao"},
    {"method": "GET", "path": "/poder/2026"},
    {"method": "GET", "path": "/documentos", "query": ["nivel", "caso_id"]},
    {"method": "GET", "path": "/fontes", "query": ["nivel"]},
    {"method": "GET", "path": "/busca", "query": ["q"]},
    {"method": "GET", "path": "/metodologia"}
  ],
  "resposta_padrao": {
    "sempre": ["id", "fontes", "grau_confirmacao|camada|confiabilidade"],
    "explicar_conexao": ["tipo", "periodo", "contexto", "justificativa_documental", "fonte"],
    "proibir": ["inferir culpa de citação", "tratar Centrão como org criminosa", "pintar hipótese como fato"]
  },
  "homonimos": {
    "estrategia": "IDs estáveis + desambiguação por UF, partido, cargo, período; UI mostra chip de contexto"
  }
}

# Copie este arquivo para `.env` na raiz e preencha localmente.
# NUNCA commite o arquivo `.env` — o repositório público não deve conter chaves reais.

# --- API / portal (obrigatório em produção) ---
# Chave interna do portal Atlas (autenticação entre serviços / rotas protegidas)
# ATLAS_PORTAL_API_KEY=

# --- DataJud (CNJ) — chave pública da API Pública ---
# Obtenha em: https://datajud-wiki.cnj.jus.br/api-publica/acesso/
# ATLAS_DATAJUD_API_KEY=

# --- Ingestão / filas (opcional) ---
# CNPJ_DUMP_URL=
# ONDA2_SKIP_DATAJUD=0
# Fila NPU local (não versionada): data/lake/queues/datajud_npus.jsonl

# --- Receita / CNO (opcional) ---
# Caminho local para ZIP/CSV se o portal estiver fora
# ATLAS_CONTENCIOSO_FILE=data/manual/receita
# ATLAS_CNO_FILE=data/manual/receita/cno.zip
# ATLAS_TRANSACAO_FILE=data/manual/receita/transacao.csv
# Token de share WebDAV SERPRO/RFB para CNO (se usar mirror oficial)
# ATLAS_SERPRO_CNO_SHARE_TOKEN=
# ATLAS_CNO_SAMPLE_LIMIT=5000

# --- Storage lake (MinIO / dual) ---
# ATLAS_STORAGE_BACKEND=dual
# ATLAS_MINIO_ENABLED=1
# ATLAS_MINIO_ENDPOINT=http://127.0.0.1:9000
# Usuário/senha do MinIO local (dev). Em produção, use segredos fortes.
# ATLAS_MINIO_ACCESS_KEY=
# ATLAS_MINIO_SECRET_KEY=
# ATLAS_MINIO_BUCKET=atlas-raw

# --- URLs da API (Windows: preferir localhost; compose mapeia 8001→8000) ---
# ATLAS_API_URL=http://localhost:8001
# NEXT_PUBLIC_ATLAS_API_URL=http://localhost:8001
